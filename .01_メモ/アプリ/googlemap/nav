実装コード
以下にReact Nativeを用いたサンプルコードを記載します。

javascript
コードをコピーする
import React, { Component, useState } from 'react';
import { View, Text, StyleSheet, TouchableOpacity, FlatList } from 'react-native';
import MapView, { Marker } from 'react-native-maps';
import BottomSheet from '@gorhom/bottom-sheet';

// 親クラスコンポーネント
class ParentComponent extends Component {
  state = {
    activeMarkers: [], // 現在アクティブなマーカーのID
    searchResults: [1, 3], // 検索ヒットしたマーカーのID
    filterIcons: [], // フィルターアイコンとして表示するマーカーのID
  };

  // マーカーを活性化または非活性化する関数
  toggleMarker = (id) => {
    const { activeMarkers, filterIcons } = this.state;

    if (activeMarkers.includes(id)) {
      // マーカーが既にアクティブなら非活性化
      this.setState({
        activeMarkers: activeMarkers.filter((markerId) => markerId !== id),
        filterIcons: filterIcons.filter((iconId) => iconId !== id),
      });
    } else {
      // マーカーを活性化
      this.setState({
        activeMarkers: [...activeMarkers, id],
        filterIcons: [...filterIcons, id],
      });
    }
  };

  // フィルターアイコンを削除する関数
  removeFilterIcon = (id) => {
    const { activeMarkers, searchResults } = this.state;

    this.setState({
      filterIcons: this.state.filterIcons.filter((iconId) => iconId !== id),
      activeMarkers: searchResults.includes(id)
        ? [...new Set([...activeMarkers, id])] // 検索結果に戻る場合
        : activeMarkers.filter((markerId) => markerId !== id),
    });
  };

  render() {
    const { activeMarkers, searchResults, filterIcons } = this.state;

    return (
      <View style={styles.container}>
        {/* MapViewを表示 */}
        <MapViewComponent
          activeMarkers={activeMarkers}
          toggleMarker={this.toggleMarker}
        />

        {/* ボトムシートを表示 */}
        <BottomSheetComponent
          filterIcons={filterIcons}
          removeFilterIcon={this.removeFilterIcon}
        />
      </View>
    );
  }
}

// MapViewクラスコンポーネント
class MapViewComponent extends Component {
  render() {
    const { activeMarkers, toggleMarker } = this.props;

    // 仮のマーカーリスト
    const markers = [
      { id: 1, latitude: 37.78825, longitude: -122.4324 },
      { id: 2, latitude: 37.78925, longitude: -122.4325 },
      { id: 3, latitude: 37.79025, longitude: -122.4326 },
      { id: 4, latitude: 37.79125, longitude: -122.4327 },
    ];

    return (
      <MapView style={styles.map}>
        {markers.map((marker) => (
          <Marker
            key={marker.id}
            coordinate={{ latitude: marker.latitude, longitude: marker.longitude }}
            pinColor={activeMarkers.includes(marker.id) ? 'red' : 'gray'}
            onPress={() => toggleMarker(marker.id)}
          />
        ))}
      </MapView>
    );
  }
}

// ボトムシート関数コンポーネント
const BottomSheetComponent = ({ filterIcons, removeFilterIcon }) => {
  const [sheetIndex, setSheetIndex] = useState(1);

  return (
    <BottomSheet
      index={sheetIndex}
      snapPoints={['25%', '50%']}
      onChange={(index) => setSheetIndex(index)}
    >
      <View style={styles.bottomSheetContent}>
        <Text>フィルターアイコン:</Text>
        <FlatList
          data={filterIcons}
          keyExtractor={(item) => item.toString()}
          renderItem={({ item }) => (
            <TouchableOpacity
              style={styles.filterIcon}
              onPress={() => removeFilterIcon(item)}
            >
              <Text>マーカー {item}</Text>
            </TouchableOpacity>
          )}
        />
      </View>
    </BottomSheet>
  );
};

// スタイル
const styles = StyleSheet.create({
  container: {
    flex: 1,
  },
  map: {
    flex: 1,
  },
  bottomSheetContent: {
    padding: 10,
  },
  filterIcon: {
    padding: 10,
    marginVertical: 5,
    backgroundColor: '#ddd',
    borderRadius: 5,
  },
});

export default ParentComponent;
コードの説明
状態管理:

activeMarkers: 現在アクティブなマーカーのIDを保持。
searchResults: 初期状態の検索結果のマーカーID。
filterIcons: ボトムシートに表示するフィルターアイコンのリスト。
関数の役割:

toggleMarker: マーカーを活性化/非活性化。マーカーをタップすると呼ばれる。
removeFilterIcon: フィルターアイコンを削除し、対応するマーカーを非活性化。
コンポーネントの役割:

MapViewComponent: マーカーを表示し、タップで状態を切り替える。
BottomSheetComponent: フィルターアイコンを表示し、タップでアイコンとマーカーの状態を更新。
動作の流れ
検索結果（例: ID 1と3）のマーカーが初期状態でアクティブになる。
任意のマーカーをタップするとアクティブ/非アクティブが切り替わり、フィルターアイコンに追加/削除される。
フィルターアイコンをタップすると、対応するマーカーが非アクティブになり、アイコンが消える。
フィルターアイコンがすべて消えると、初期検索結果（ID 1と3）が再度アクティブになる。
このコードを参考に、必要に応じてUIや状態管理をカスタマイズしてください。






あなた:
クラスコンポーネントのゲッターセッターの使い方を教えて
ChatGPT:
ChatGPT
クラスコンポーネントにおいて、ゲッターとセッターを使用することで、特定のプロパティにアクセスする際の振る舞いをカスタマイズすることができます。以下にReactでの具体的な使い方を解説します。

基本構文
ゲッターとセッターは、クラスのプロパティを動的に操作するためにJavaScriptのgetterとsetterを使います。

例: 基本的なゲッターとセッター
javascript
コードをコピーする
class ExampleComponent extends React.Component {
  constructor(props) {
    super(props);
    this._value = 0; // 内部プロパティ
  }

  // ゲッター
  get value() {
    console.log('ゲッターが呼ばれました');
    return this._value;
  }

  // セッター
  set value(newValue) {
    console.log('セッターが呼ばれました');
    if (newValue >= 0) {
      this._value = newValue;
    } else {
      console.error('値は0以上でなければなりません');
    }
  }

  render() {
    return (
      <div>
        <p>値: {this.value}</p>
        <button onClick={() => (this.value = this.value + 1)}>増加</button>
      </div>
    );
  }
}

export default ExampleComponent;
コードの解説
constructor内で内部プロパティ _value を定義:

プライベートなデータとして_valueを管理。
_valueは外部から直接アクセスされない。
ゲッターget value():

this.valueと記述した際に呼び出される。
内部プロパティ_valueの値を返す。
セッターset value(newValue):

this.value = newValueのように代入すると呼び出される。
新しい値を検証したり、条件を適用して内部プロパティ_valueを更新する。
レンダリング中にthis.valueを使用:

this.valueでゲッターが呼び出され、値を取得して表示。
ボタンのクリックで値を増加:

セッターを通じて_valueを更新。
Reactでの利用上の注意
stateと組み合わせて使用する場合: Reactではstateを使うのが基本です。ただし、ゲッター/セッターをstateと組み合わせることで、読みやすいコードを記述できます。
例: stateとゲッター/セッターの組み合わせ
javascript
コードをコピーする
class CounterComponent extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      count: 0, // カウントをstateで管理
    };
  }

  // ゲッター
  get count() {
    return this.state.count;
  }

  // セッター
  set count(newCount) {
    if (newCount >= 0) {
      this.setState({ count: newCount });
    } else {
      console.error('カウントは0以上でなければなりません');
    }
  }

  render() {
    return (
      <div>
        <p>カウント: {this.count}</p>
        <button onClick={() => (this.count = this.count + 1)}>増加</button>
        <button onClick={() => (this.count = this.count - 1)}>減少</button>
      </div>
    );
  }
}

export default CounterComponent;
コードのポイント
stateをゲッター/セッターで隠蔽:

this.state.countではなく、this.countとしてアクセスできる。
セッターで制約を追加:

カウントが0未満になることを防止。
this.setStateで状態を更新:

Reactの再レンダリングを保証。
応用例
ゲッターとセッターは、計算されたプロパティやデータの正規化に便利です。

例: 計算されたプロパティ
javascript
コードをコピーする
class PriceComponent extends React.Component {
  constructor(props) {
    super(props);
    this.state = {
      price: 100,
      taxRate: 0.1, // 税率
    };
  }

  // ゲッター: 税込み価格
  get totalPrice() {
    return this.state.price * (1 + this.state.taxRate);
  }

  render() {
    return (
      <div>
        <p>商品の価格: {this.state.price}円</p>
        <p>税込み価格: {this.totalPrice}円</p>
      </div>
    );
  }
}

export default PriceComponent;
ゲッター/セッターの使いどころ
データのカプセル化: 内部状態を直接変更させない。
状態の計算や検証: データを加工して返す、または検証して設定する。
読みやすいコード: コンポーネントのプロパティとして振る舞いを定義。
まとめ
Reactクラスコンポーネントでは、ゲッター/セッターを以下のように使うと効果的です:

内部状態をカプセル化。
状態の計算ロジックを簡略化。
状態変更時の検証や制約を追加。
ただし、現在では関数コンポーネントとフックが主流です。クラスコンポーネントが必要な場合に限り、ゲッター/セッターを活用してください。






