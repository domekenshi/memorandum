lat-lan のような文字列をカンマで区切り、それぞれの部分を別の変数に格納するには、Javaで文字列の操作を行う必要があります。以下の例では、ReadableMap から lat-lan キーの値を取得し、その値をカンマで分割して latitude と longitude という二つの変数に格納します。

Javaでのモジュールの実装
java
Copy code
package com.example.reactmodule;

import com.facebook.react.bridge.ReactApplicationContext;
import com.facebook.react.bridge.ReactContextBaseJavaModule;
import com.facebook.react.bridge.ReactMethod;
import com.facebook.react.bridge.ReadableMap;

public class ExampleModule extends ReactContextBaseJavaModule {
    public ExampleModule(ReactApplicationContext reactContext) {
        super(reactContext);
    }

    @Override
    public String getName() {
        return "ExampleModule";
    }

    @ReactMethod
    public void showLocation(ReadableMap info) {
        // ReadableMapから "lat-lan" キーで文字列を取得
        String latLonString = info.getString("lat-lan");
        // カンマで分割
        String[] parts = latLonString.split(",");
        // 分割した文字列を double 型に変換してそれぞれ格納
        double latitude = Double.parseDouble(parts[0]);
        double longitude = Double.parseDouble(parts[1]);

        // 例としてToastを表示
        Toast.makeText(getReactApplicationContext(), "Latitude: " + latitude + ", Longitude: " + longitude, Toast.LENGTH_LONG).show();
    }
}
