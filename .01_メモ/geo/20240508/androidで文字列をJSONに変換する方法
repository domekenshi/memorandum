package com.example.jsonexample;

import android.os.Bundle;
import android.widget.TextView;
import androidx.appcompat.app.AppCompatActivity;
import org.json.JSONArray;
import org.json.JSONException;
import org.json.JSONObject;

public class MainActivity extends AppCompatActivity {

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        TextView textView = findViewById(R.id.text_view);

        // JSON形式の文字列
        String jsonString = "{\"name\":\"John\", \"age\":30}";
        String jsonArrayString = "[{\"name\":\"John\", \"age\":30}, {\"name\":\"Jane\", \"age\":25}]";

        try {
            // 文字列からJSONObjectを作成
            JSONObject jsonObject = new JSONObject(jsonString);
            String name = jsonObject.getString("name");
            int age = jsonObject.getInt("age");

            // 文字列からJSONArrayを作成
            JSONArray jsonArray = new JSONArray(jsonArrayString);
            StringBuilder builder = new StringBuilder();
            for (int i = 0; i < jsonArray.length(); i++) {
                JSONObject item = jsonArray.getJSONObject(i);
                builder.append("Name: ").append(item.getString("name"))
                       .append(", Age: ").append(item.getInt("age")).append("\n");
            }

            // TextViewに結果を表示
            textView.setText("JSONObject:\nName: " + name + ", Age: " + age + "\n\nJSONArray:\n" + builder.toString());

        } catch (JSONException e) {
            e.printStackTrace();
            textView.setText("Error parsing JSON");
        }
    }
}
