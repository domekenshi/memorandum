public class GeofenceBroadcastReceiver extends BroadcastReceiver {
    @Override
    public void onReceive(Context context, Intent intent) {
        GeofencingEvent geofencingEvent = GeofencingEvent.fromIntent(intent);
        if (geofencingEvent.hasError()) {
            Log.e("GeofenceReceiver", "エラー発生: " + geofencingEvent.getErrorCode());
            return;
        }

        int transitionType = geofencingEvent.getGeofenceTransition();
        String transitionMessage = "";

        if (transitionType == Geofence.GEOFENCE_TRANSITION_ENTER) {
            transitionMessage = "ジオフェンスエリアに入りました";
        } else if (transitionType == Geofence.GEOFENCE_TRANSITION_EXIT) {
            transitionMessage = "ジオフェンスエリアから出ました";
        }

        Log.d("GeofenceReceiver", transitionMessage);
    }
}
onReceive() でジオフェンスのイベントをキャッチ
geofencingEvent.getGeofenceTransition() で 進入 or 退出 を判定
